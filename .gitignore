# 默认忽略文件和目录，只放行项目路径；新增文件类型需在对应分组登记。
*

# 根目录的共享配置与文档。
!/.gitattributes
!/.gitignore
!/.gitmodules
!/AGENTS.md
!/CLAUDE.md
!/CMakeLists.txt
!/LEGAL
!/LICENSE
!/README.md
!/README.zh-CN.md

# 产品入口与源码；只放行目录不会放行其中的文件。
!/Telegram/
!/Telegram/CMakeLists.txt
!/Telegram/Telegram.plist
!/Telegram/configure.bat
!/Telegram/configure.py
!/Telegram/configure.sh
!/Telegram/create.bat
!/Telegram/SourceFiles/
!/Telegram/SourceFiles/**/
!/Telegram/SourceFiles/**/*.[chm]
!/Telegram/SourceFiles/**/*.[ch]pp
!/Telegram/SourceFiles/**/*.mm
!/Telegram/SourceFiles/**/*.style
!/Telegram/SourceFiles/**/*.idl
!/Telegram/SourceFiles/**/*.xml
!/Telegram/SourceFiles/mtproto/scheme/*.tl
!/Telegram/SourceFiles/codegen/scheme/codegen_scheme.py
!/Telegram/SourceFiles/test/README.md
!/Telegram/SourceFiles/gram/tests/fixtures/*.json
!/Telegram/SourceFiles/gram/tests/fixtures/fragment-imgproxy-deskcalendar-small.bin
!/Telegram/SourceFiles/gram/tests/fixtures/fragment-gift-deskcalendar-45754-image.webp

# 界面资源；模型、公钥、词表及签名按用途单独放行。
!/Telegram/Resources/
!/Telegram/Resources/**/
!/Telegram/Resources/**/*.svg
!/Telegram/Resources/**/*.png
!/Telegram/Resources/**/*.jpg
!/Telegram/Resources/**/*.webp
!/Telegram/Resources/**/*.ico
!/Telegram/Resources/**/*.tiff
!/Telegram/Resources/**/*.tgs
!/Telegram/Resources/**/*.tgv
!/Telegram/Resources/**/*.lottie
!/Telegram/Resources/**/*.mp3
!/Telegram/Resources/**/*.ttf
!/Telegram/Resources/**/*.strings
!/Telegram/Resources/**/*.css
!/Telegram/Resources/**/*.html
!/Telegram/Resources/**/*.js
!/Telegram/Resources/*.tdesktop-theme
!/Telegram/Resources/default_shortcuts-custom.json
!/Telegram/Resources/emoji/emoji_presets.json
!/Telegram/Resources/langs/extras/*.json
!/Telegram/Resources/langs/*.py
!/Telegram/Resources/langs/*.sh
!/Telegram/Resources/qrc/**/*.qrc
!/Telegram/Resources/winrc/*.manifest
!/Telegram/Resources/winrc/*.rc
!/Telegram/Resources/art/premium/*.obj
!/Telegram/Resources/art/premium/diamond/*.bin
!/Telegram/Resources/fonts/README.md
!/Telegram/Resources/fonts/OFL.txt
!/Telegram/Resources/numbers.txt
!/Telegram/Resources/zxcvbn/README.md
!/Telegram/Resources/zxcvbn/*.txt
!/Telegram/Resources/update/.gitattributes
!/Telegram/Resources/update/root-public.pem
!/Telegram/Resources/update/manifest.min.json
!/Telegram/Resources/update/manifest.sig

# macOS 包资源与着色器源码。
!/Telegram/Telegram/
!/Telegram/Telegram/**/
!/Telegram/Telegram/*.entitlements
!/Telegram/Telegram/AppIcon-*.icon/icon.json
!/Telegram/Telegram/AppIcon-*.icon/Assets/*.svg
!/Telegram/Telegram/Images.xcassets/**/Contents.json
!/Telegram/Telegram/Images.xcassets/**/*.png
!/Telegram/shaders/
!/Telegram/shaders/**/
!/Telegram/shaders/**/*.comp
!/Telegram/shaders/**/*.frag
!/Telegram/shaders/**/*.vert

# 构建输入，不放行根目录 build/ 或产品构建输出。
!/Telegram/cmake/
!/Telegram/cmake/**/
!/Telegram/cmake/**/*.cmake
!/Telegram/cmake/**/*.py
!/Telegram/cmake/*.h.in
!/Telegram/cmake/*.props
!/Telegram/build/
!/Telegram/build/**/
!/Telegram/build/**/*.py
!/Telegram/build/**/*.sh
!/Telegram/build/**/*.bat
!/Telegram/build/**/*.vbs
!/Telegram/build/**/*.iss
!/Telegram/build/**/*.patch
!/Telegram/build/**/CMakeLists.txt
!/Telegram/build/version
!/Telegram/build/docker/centos_env/.gitignore
!/Telegram/build/docker/centos_env/Dockerfile
!/Telegram/build/docker/centos_env/poetry.lock
!/Telegram/build/docker/centos_env/pyproject.toml
!/scripts/
!/scripts/**/
!/scripts/**/*.py
!/scripts/**/*.sh
!/lib/
!/lib/xdg/
!/lib/xdg/*.desktop
!/lib/xdg/*.xml
!/lib/xdg/*.service

# 发布配置与共享技能，不放行会话、任务记录和本机设置。
!/.github/
!/.github/CHANGELOG.md
!/.github/CONTRIBUTING.md
!/.github/upstream.json
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/*.yml
!/.github/workflows/
!/.github/workflows/*.yml
!/.github/scripts/
!/.github/scripts/*.py
!/.github/scripts/*.sh
!/.claude/
!/.claude/skills/
!/.claude/skills/**/
!/.claude/skills/*/SKILL.md
!/.claude/skills/*/guides/*.md
!/.claude/skills/*/scripts/**/*.py
!/.codex/
!/.codex/skills/
!/.codex/skills/**/
!/.codex/skills/*/SKILL.md
!/.codex/skills/*/guides/*.md
!/.codex/skills/*/scripts/**/*.py
!/.pi/
!/.pi/settings.json

# 只放行 .gitmodules 已登记的子模块入口，不接管子模块内部规则。
!/cmake/
!/Telegram/codegen/
!/Telegram/lib_base/
!/Telegram/lib_crl/
!/Telegram/lib_icu/
!/Telegram/lib_lottie/
!/Telegram/lib_qr/
!/Telegram/lib_rpl/
!/Telegram/lib_spellcheck/
!/Telegram/lib_storage/
!/Telegram/lib_tl/
!/Telegram/lib_translate/
!/Telegram/lib_ui/
!/Telegram/lib_webrtc/
!/Telegram/lib_webview/
!/Telegram/ThirdParty/
!/Telegram/ThirdParty/GSL/
!/Telegram/ThirdParty/MicroTeX/
!/Telegram/ThirdParty/QR/
!/Telegram/ThirdParty/TooManyCooks/
!/Telegram/ThirdParty/cld3/
!/Telegram/ThirdParty/cmark-gfm/
!/Telegram/ThirdParty/expected/
!/Telegram/ThirdParty/fcitx5-qt/
!/Telegram/ThirdParty/hime/
!/Telegram/ThirdParty/hunspell/
!/Telegram/ThirdParty/kcoreaddons/
!/Telegram/ThirdParty/kimageformats/
!/Telegram/ThirdParty/libcbor/
!/Telegram/ThirdParty/libfido2/
!/Telegram/ThirdParty/libprisma/
!/Telegram/ThirdParty/lz4/
!/Telegram/ThirdParty/nimf/
!/Telegram/ThirdParty/range-v3/
!/Telegram/ThirdParty/tgcalls/
!/Telegram/ThirdParty/xdg-desktop-portal/
!/Telegram/ThirdParty/xxHash/
!/Telegram/ThirdParty/zxcvbn/

# 本地配置、会话导出、元数据和生成缓存即使位于白名单目录内也不跟踪。
.env*
*.local.*
._*
pi-session*.html
codex-session*
__pycache__/
CMakeFiles/
.cmake/
.cache/
.venv/
.vs/
.vscode/
.idea/
/Telegram/SourceFiles/_other/packer_private.h
