using "ui/basic.style";
using "ui/layers/layers.style";
using "ui/widgets/widgets.style";
using "info/info.style";
using "settings/settings.style";

settingsPageSidebarWidth: 224px;
settingsPageTwoColumnWidth: 680px;
settingsPageGridTwoColumnWidth: 420px;
settingsPageHeaderHeight: infoTopBarHeight;
settingsPageProfileHeight: 76px;
settingsPageRowHeight: 42px;
settingsPageTileHeight: 100px;
settingsPageInset: 20px;
settingsPageSmallSkip: 10px;
settingsPageRadius: 8px;

settingsPageTitle: FlatLabel(defaultFlatLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(16px semibold);
	}
}
settingsPageProfileName: FlatLabel(defaultFlatLabel) {
	maxHeight: 20px;
	style: TextStyle(defaultTextStyle) {
		font: font(13px semibold);
	}
}
settingsPageCaption: FlatLabel(defaultFlatLabel) {
	maxHeight: 18px;
	textFg: windowSubTextFg;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}
settingsPageSidebarPhoto: UserpicButton(defaultUserpicButton) {
	size: size(40px, 40px);
	photoSize: 40px;
}
settingsPageOverviewPhoto: UserpicButton(defaultUserpicButton) {
	size: size(52px, 52px);
	photoSize: 52px;
	uploadHeight: 18px;
}

centeredBoxLabelStyle: TextStyle(boxLabelStyle) {
    font: font(13px);
    lineHeight: 0px;
}

centeredBoxLabel: FlatLabel(defaultFlatLabel) {
	minWidth: 256px;
	align: align(center);
	style: centeredBoxLabelStyle;
}

filtersAddIcon: IconButton(infoLayerTopBarClose) {
	width: 40px;
	icon: icon {{ "menu/add", boxTitleCloseFg }};
	iconOver: icon {{ "menu/add", boxTitleCloseFgOver }};
	iconPosition: point(8px, -1px);
}

filtersExcludeIcon: IconButton(infoLayerTopBarClose) {
	width: 40px;
	icon: icon {{ "menu/tag_remove", boxTitleCloseFg }};
	iconOver: icon {{ "menu/tag_remove", boxTitleCloseFgOver }};
	iconPosition: point(8px, -1px);
}
