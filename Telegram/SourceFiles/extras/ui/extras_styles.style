using "ui/basic.style";
using "ui/colors.palette";
using "ui/widgets/widgets.style";
using "info/info.style";
using "settings/settings.style";
using "media/player/media_player.style";
using "media/view/media_view.style";

extrasMusicPlaceholder: icon {{ "menu/rich/audio", windowSubTextFg }};
extrasMediaVoice: icon {{ "extras/message_field/voice", windowSubTextFg }};
extrasMediaVideo: icon {{ "chat/input_video", windowSubTextFg }};
// 自定义图标叠加绘制时替换按钮原图标。
extrasEmptyIcon: icon {};

extrasMusicPlay: IconButton(mediaPlayerRepeatButton) {
	icon: icon {{ "player/player_play", mediaPlayerActiveFg }};
	width: 48px;
	height: 44px;
	iconPosition: point(12px, 10px);
	rippleAreaPosition: point(4px, 2px);
	rippleAreaSize: 40px;
}
extrasMusicPrevious: IconButton(mediaPlayerPreviousButton) {
	icon: icon {{ "player/player_backward", mediaPlayerActiveFg }};
	width: 40px;
	height: 44px;
	iconPosition: point(8px, 10px);
	rippleAreaPosition: point(0px, 2px);
	rippleAreaSize: 40px;
}
extrasMusicNext: IconButton(extrasMusicPrevious) {
	icon: icon {{ "player/player_forward", mediaPlayerActiveFg }};
}
extrasMusicRepeat: IconButton(mediaPlayerRepeatButton) {
	icon: icon {{ "player/player_repeat", mediaPlayerActiveFg }};
	width: 36px;
	height: 44px;
	iconPosition: point(6px, 10px);
	rippleAreaPosition: point(0px, 4px);
	rippleAreaSize: 36px;
}

extrasMusicFloatingSize: 44px;
extrasMusicFloatingShadow: 4px;
extrasMusicFloatingMargin: 16px;
extrasMusicFloatingGap: 12px;
extrasMusicCompactWidth: 340px;
extrasMusicCompactHeight: 286px;
extrasMusicCompactPadding: 18px;
extrasMusicCompactCover: 62px;
extrasMusicCompactTitle: font(15px semibold);
extrasMusicCompactSmall: font(11px);
extrasMusicCompactSource: LinkButton(defaultLinkButton) {
	font: font(11px);
	overFont: font(11px);
	color: windowSubTextFg;
	overColor: windowActiveTextFg;
}
extrasMusicCompactDropdown: InnerDropdown(defaultInnerDropdown) {
	showDuration: 160;
	scroll: ScrollArea(defaultSolidScroll) {
		barHidden: true;
	}
	scrollPadding: margins(0px, 0px, 0px, 0px);
}
extrasMusicCompactButton: IconButton(mediaPlayerRepeatButton) {
	icon: icon {};
	width: 30px;
	height: 30px;
	iconPosition: point(3px, 3px);
	rippleAreaPosition: point(1px, 1px);
	rippleAreaSize: 28px;
}
extrasMusicCompactSave: IconButton(extrasMusicCompactButton) {
	icon: icon {{ "menu/download", menuIconFg }};
	iconOver: icon {{ "menu/download", menuIconFgOver }};
}
extrasMusicCompactCollapse: IconButton(extrasMusicCompactButton) {
	icon: icon {{ "player/player_collapse", menuIconFg }};
	iconOver: icon {{ "player/player_collapse", menuIconFgOver }};
}
extrasMusicCompactClose: IconButton(extrasMusicCompactButton) {
	icon: icon {{ "player/panel_close", menuIconFg }};
	iconOver: icon {{ "player/panel_close", menuIconFgOver }};
}
extrasMusicCompactQueue: IconButton(extrasMusicCompactButton) {
	icon: icon {{ "player/player_queue", menuIconFg }};
	iconOver: icon {{ "player/player_queue", menuIconFgOver }};
}
extrasMusicCompactPlay: IconButton(extrasMusicPlay) {
	width: 44px;
	height: 44px;
	icon: icon {{ "player/player_play", windowFgActive }};
	iconPosition: point(10px, 10px);
	rippleAreaPosition: point(0px, 0px);
	rippleAreaSize: 44px;
}
extrasMusicCompactPause: icon {{ "player/player_pause", windowFgActive }};
extrasMusicCompactCancel: icon {{ "player/panel_close", windowFgActive }};

iconPickerSelectedPadding: 2px;
iconPickerSelectedRounding: 12px;
iconPickerImagePadding: 4px;
iconPickerIconSize: 64px;

recentStickersLimitPadding: margins(22px, 4px, 22px, 8px);
imageViewPadding: margins(22px, 10px, 22px, 10px);
imageViewInnerPadding: margins(16px, 16px, 16px, 16px);

botWebViewPanelHeightIncreased: 782px;
botWebViewPanelWidthIncreased: 512px;

stickerRoundingSize: 5px;

messageShotPadding: 4px;

topBarAdmins: IconButton {
	width: 40px;
	height: topBarHeight;

	icon: icon {{ "extras/top_bar_admins", menuIconFg }};
	iconOver: icon {{ "extras/top_bar_admins", menuIconFgOver }};
	iconPosition: point(4px, 11px);

	rippleAreaPosition: point(0px, 7px);
	rippleAreaSize: 40px;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgOver;
	}
}

topBarRecentActions: IconButton {
	width: 40px;
	height: topBarHeight;

	icon: icon {{ "extras/top_bar_recent_actions", menuIconFg }};
	iconOver: icon {{ "extras/top_bar_recent_actions", menuIconFgOver }};
	iconPosition: point(4px, 11px);

	rippleAreaPosition: point(0px, 7px);
	rippleAreaSize: 40px;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: windowBgOver;
	}
}

exteraBadgeToast: Toast(defaultToast) {
	minWidth: 40px;
	maxWidth: 480px;
	padding: margins(54px, 13px, 19px, 12px);
}

exteraBadgeToastBadge: InfoPeerBadge(infoPeerBadge) {
	premiumFg: toastFg;
}


unreadPillPadding: 12px;

infoProfileLabeledButtonRegistrationDate: IconButton(defaultIconButton) {
	width: 34px;
	height: 34px;
	icon: icon {{ "menu/calendar", windowActiveTextFg }};
	iconOver: icon {{ "menu/calendar", windowActiveTextFg }};
	rippleAreaPosition: point(0px, 0px);
	rippleAreaSize: 34px;
	ripple: defaultRippleAnimation;
}
registrationDateImportantTooltipLabel: FlatLabel(defaultImportantTooltipLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}

pluginShowInFolderIcon: icon {{ "menu/show_in_folder", boxTitleCloseFg }};
pluginShowInFolderIconOver: icon {{ "menu/show_in_folder", boxTitleCloseFgOver }};
pluginShowInFolder: IconButton(defaultIconButton) {
	width: boxTitleHeight;
	height: boxTitleHeight;

	icon: pluginShowInFolderIcon;
	iconOver: pluginShowInFolderIconOver;

	rippleAreaPosition: point(4px, 4px);
	rippleAreaSize: 40px;
	ripple: defaultRippleAnimationBgOver;
}
maxPluginDescriptionHeight: 400px;
pluginVersionAuthorLabel: FlatLabel(boxLabel) {
    align: align(center);
}
pluginChipSkip: 6px;

ghostPickerArrow: icon{{ "info/edit/expand_arrow_small", windowActiveTextFg }};

ghostPickerButton: LinkButton(defaultLinkButton) {
	color: windowActiveTextFg;
	overColor: windowActiveTextFg;
	font: font(boxFontSize);
	overFont: font(boxFontSize);
}

extrasBetaBadgePadding: margins(4px, 1px, 4px, 1px);

extrasServiceTimeBadgeFont: font(11px semibold);
extrasServiceTimeBadgeHorizontalPadding: 7px;
extrasServiceTimeBadgeVerticalPadding: 2px;
extrasServiceTimeBadgeGap: 8px;
extrasServiceTimeBadgeTrailingInset: 3px;
extrasServiceTimeBadgeLastLineWidthAdd: 9px;

// 提示放在鼠标指针下方足够远处，避免被指针遮住。
topBarTooltip: Tooltip(defaultTooltip) {
	shift: point(-20px, 32px);
}
topBarSelectionForward: IconButton(topBarSearch) {
	icon: icon {{ "menu/forward", menuIconFg }};
	iconOver: icon {{ "menu/forward", menuIconFgOver }};
	iconPosition: point(-1px, -1px);
}
topBarSelectionNoQuote: IconButton(topBarSelectionForward) {
	icon: icon {{ "menu/name_hide", menuIconFg }};
	iconOver: icon {{ "menu/name_hide", menuIconFgOver }};
}
topBarSelectionSendNow: IconButton(topBarSelectionForward) {
	icon: icon {{ "menu/send", menuIconFg }};
	iconOver: icon {{ "menu/send", menuIconFgOver }};
}
topBarSelectionDelete: IconButton(topBarSelectionForward) {
	icon: icon {{ "menu/delete", menuIconFg }};
	iconOver: icon {{ "menu/delete", menuIconFgOver }};
}
topBarSelectionShot: IconButton(topBarSelectionForward) {
	icon: icon {{ "menu/image", menuIconFg }};
	iconOver: icon {{ "menu/image", menuIconFgOver }};
}
topBarSelectionBetween: IconButton(topBarSelectionForward) {
	icon: icon {{ "menu/select", menuIconFg }};
	iconOver: icon {{ "menu/select", menuIconFgOver }};
}

topicSwitcherHeight: 22px;
topicSwitcherPadding: margins(6px, 0px, 6px, 0px);
topicSwitcherSkip: 5px;
topicSwitcherTextStyle: TextStyle(defaultTextStyle) {
	font: font(13px semibold);
}
topicSwitcherChevron: size(9px, 5px);
topicSwitcherPanelWidth: 260px;
topicSwitcherPanelMaxHeight: 380px;
topicSwitcherPanelSkip: 2px;
// 左右边距与表情面板搜索框一致，行高亮与搜索框同宽、同圆角。
topicSwitcherPanelPadding: margins(8px, 8px, 8px, 7px);
topicSwitcherSearchSkip: 6px;
topicSwitcherRowHeight: 32px;
topicSwitcherRowMargin: margins(0px, 1px, 0px, 1px);
topicSwitcherRowRadius: 9px;
topicSwitcherRowPadding: margins(8px, 0px, 8px, 0px);
topicSwitcherAllIcon: icon {{ "menu/chats-18x18", windowSubTextFg }};
topicSwitcherEmptyHeight: 64px;

// 侧栏子页面与全宽页面原地过渡的平移距离；切换对话与设置子页面淡化的时长。
extrasSectionCrossFadeShift: 24px;
extrasInPlaceFadeDuration: 200;

// 窗口内查看器：图片四周留白，给顶栏、翻页按钮和底部缩略图条让出位置。
extrasViewerContentPadding: margins(92px, 66px, 92px, 122px);

// 窗口内查看器顶栏：左侧头像、名字和时间，右侧操作按钮自右向左排列。
extrasViewerTopBarHeight: 64px;
extrasViewerTopBarPadding: margins(18px, 0px, 12px, 0px);
extrasViewerTopBarButton: 38px;
extrasViewerTopBarButtonSkip: 2px;
extrasViewerTopBarButtonRadius: 10px;
// 分隔线把全屏、更多、关闭与媒体操作分成两组。
extrasViewerTopBarSeparator: size(1px, 18px);
extrasViewerTopBarSeparatorSkip: 6px;
extrasViewerUserpicSize: 34px;
extrasViewerUserpicSkip: 10px;
extrasViewerDateFont: font(12px);
extrasViewerFullScreen: icon {{ "player/player_fullscreen", mediaviewControlFg }};
extrasViewerFullScreenOut: icon {{ "player/player_minimize", mediaviewControlFg }};
extrasViewerClose: icon {{ "extras/viewer_close", mediaviewControlFg }};

// 窗口内查看器展开到全屏、收回窗口内的时长。
extrasViewerFullScreenDuration: 260;
// 窗口内查看器的翻页按钮：左右两侧垂直居中的圆形。
extrasViewerNavSize: 48px;
extrasViewerNavSkip: 20px;
// 窗口内查看器的视频控制条贴在视频底边内侧，视频太窄时按最小宽度显示。
extrasViewerControllerSkip: 10px;
extrasViewerControllerMinWidth: 320px;
// 窗口内查看器的底部缩略图条：小方块圆角缩略图，当前项更宽并带描边。
extrasViewerGroupHeight: 40px;
extrasViewerGroupWidth: 40px;
extrasViewerGroupWidthMax: 54px;
extrasViewerGroupSkip: 3px;
extrasViewerGroupRadius: 8px;
extrasViewerGroupPadding: margins(6px, 6px, 6px, 6px);
extrasViewerGroupBottom: 16px;
extrasViewerGroupBgRadius: 14px;
extrasViewerGroupOutline: 2px;
extrasViewerGroupOutlineSkip: 1px;
extrasViewerGroupPlay: size(9px, 12px);
extrasViewerGroupCounterFont: font(12px);
extrasViewerGroupCounterSkip: 12px;

// 视频控制条：经典查看器沿用官方的固定深色，窗口内查看器跟随主题配色。
ExtrasViewerPlayback {
	bg: color;
	bgOpacity: double;
	radius: pixels;
	play: IconButton;
	pauseIcon: icon;
	pauseIconOver: icon;
	volume: IconButton;
	volumeIcon1: icon;
	volumeIcon1Over: icon;
	volumeIcon2: icon;
	volumeIcon2Over: icon;
	fullScreen: IconButton;
	fullScreenOutIcon: icon;
	fullScreenOutIconOver: icon;
	pip: IconButton;
	settings: MediaSpeedButton;
	slider: MediaSlider;
	progress: LabelSimple;
	timestamp: LabelSimple;
}
extrasViewerPlaybackClassic: ExtrasViewerPlayback {
	bg: mediaviewSaveMsgBg;
	bgOpacity: 1.;
	radius: mediaviewControllerRadius;
	play: mediaviewPlayButton;
	pauseIcon: mediaviewPauseIcon;
	pauseIconOver: mediaviewPauseIconOver;
	volume: mediaviewVolumeToggle;
	volumeIcon1: mediaviewVolumeIcon1;
	volumeIcon1Over: mediaviewVolumeIcon1Over;
	volumeIcon2: mediaviewVolumeIcon2;
	volumeIcon2Over: mediaviewVolumeIcon2Over;
	fullScreen: mediaviewFullScreenButton;
	fullScreenOutIcon: mediaviewFullScreenOutIcon;
	fullScreenOutIconOver: mediaviewFullScreenOutIconOver;
	pip: mediaviewPipButton;
	settings: mediaviewSpeedButton;
	slider: mediaviewPlayback;
	progress: mediaviewPlayProgressLabel;
	timestamp: mediaviewTimestampLabel;
}
extrasViewerPlaybackRipple: RippleAnimation(defaultRippleAnimation) {
	color: windowBgOver;
}
// 配色参照音乐播放条：播放键与进度用强调色，其余图标用菜单图标色。
extrasViewerPlayback: ExtrasViewerPlayback {
	bg: windowBg;
	bgOpacity: 0.94;
	radius: 12px;
	play: IconButton(mediaviewPlayButton) {
		icon: icon {{ "player/player_play_big", mediaPlayerActiveFg }};
		iconOver: icon {{ "player/player_play_big", mediaPlayerActiveFg }};
		ripple: extrasViewerPlaybackRipple;
	}
	pauseIcon: icon {{ "player/player_pause_big", mediaPlayerActiveFg }};
	pauseIconOver: icon {{ "player/player_pause_big", mediaPlayerActiveFg }};
	volume: IconButton(mediaviewVolumeToggle) {
		icon: icon {{ "player/player_volume_off", menuIconFg }};
		iconOver: icon {{ "player/player_volume_off", menuIconFgOver }};
		ripple: extrasViewerPlaybackRipple;
	}
	volumeIcon1: icon {{ "player/player_volume_small", menuIconFg }};
	volumeIcon1Over: icon {{ "player/player_volume_small", menuIconFgOver }};
	volumeIcon2: icon {{ "player/player_volume_on", menuIconFg }};
	volumeIcon2Over: icon {{ "player/player_volume_on", menuIconFgOver }};
	fullScreen: IconButton(mediaviewFullScreenButton) {
		icon: icon {{ "player/player_fullscreen", menuIconFg }};
		iconOver: icon {{ "player/player_fullscreen", menuIconFgOver }};
		ripple: extrasViewerPlaybackRipple;
	}
	fullScreenOutIcon: icon {{ "player/player_minimize", menuIconFg }};
	fullScreenOutIconOver: icon {{ "player/player_minimize", menuIconFgOver }};
	pip: IconButton(mediaviewPipButton) {
		icon: icon {{ "player/player_pip", menuIconFg }};
		iconOver: icon {{ "player/player_pip", menuIconFgOver }};
		ripple: extrasViewerPlaybackRipple;
	}
	settings: MediaSpeedButton(mediaviewSpeedButton) {
		fg: menuIconFg;
		overFg: menuIconFgOver;
		activeFg: mediaPlayerActiveFg;
		icon: icon {{ "player/player_settings", menuIconFg }};
		ripple: extrasViewerPlaybackRipple;
		rippleActiveColor: lightButtonBgOver;
		menu: mediaPlayerSpeedMenu;
	}
	slider: MediaSlider(mediaviewPlayback) {
		activeFg: mediaPlayerActiveFg;
		inactiveFg: mediaPlayerInactiveFg;
		activeFgOver: mediaPlayerActiveFg;
		inactiveFgOver: mediaPlayerInactiveFg;
		activeFgDisabled: mediaPlayerActiveFg;
		inactiveFgDisabled: mediaPlayerInactiveFg;
		receivedTillFg: mediaPlayerInactiveFg;
	}
	progress: LabelSimple(mediaviewPlayProgressLabel) {
		textFg: windowSubTextFg;
	}
	timestamp: LabelSimple(mediaviewTimestampLabel) {
		textFg: windowSubTextFg;
	}
}
// 窗口内查看器淡入、淡出的时长。
extrasViewerShowDuration: 240;
extrasViewerHideDuration: 200;
