extrasEmptyStateChats: icon {{ "extras/empty_state/chats", windowSubTextFg }};
extrasEmptyStateBlocked: icon {{ "extras/empty_state/blocked", windowSubTextFg }};
extrasEmptyStateGifts: icon {{ "extras/empty_state/gifts", windowSubTextFg }};

extrasGhostIcon: icon {{ "extras/ghost", menuIconColor }};
extrasGhostModeGlobalIcon: icon {{ "extras/ghost_mode_global", historyPeerUserpicFg }};
extrasEditsHistoryIcon: icon {{ "extras/edits_history", menuIconColor }};
extrasStreamerModeMenuIcon: icon {{ "extras/streamer", menuIconColor }};
extrasToBeginningMenuIcon: icon {{ "extras/to_beginning", menuIconColor }};
extrasRepeatMenuIcon: icon {{ "extras/repeat", menuIconColor }};
extrasContactsMutualIcon: icon {{ "extras/contacts_mutual", contactsStatusFg }};
extrasContactsMutualIconOver: icon {{ "extras/contacts_mutual", contactsStatusFgOver }};
extrasWalletBotIcon: icon {{ "extras/wallet_bot", menuIconColor }};

messageFieldAttachIcon: icon {{ "extras/message_field/attach", menuIconColor }};
messageFieldEmojiIcon: icon {{ "extras/message_field/emoji", menuIconColor }};
messageFieldVoiceIcon: icon {{ "extras/message_field/voice", menuIconColor }};
extrasRecordMessageIcon: icon {{ "extras/record_message", menuIconColor }};
extrasRecordRoundIcon: icon {{ "extras/record_round", menuIconColor }};
messageFieldTTLIcon: icon {{ "extras/message_field/ttl", menuIconColor }};
messageFieldCocoonAiIcon: icon {{ "chat/ai_letters-24x24", menuIconColor }};

inChannelBadgeIcon: icon {{ "extras/channel", msgInDateFg }};
inChannelBadgeSelectedIcon: icon {{ "extras/channel", msgInDateFgSelected }};
outChannelBadgeIcon: icon {{ "extras/channel", msgOutDateFg }};
outChannelBadgeSelectedIcon: icon {{ "extras/channel", msgOutDateFgSelected }};

infoExteraOfficialBadge: icon {{ "extras/extera_official", profileVerifiedCheckBg }};
infoExteraSupporterBadge: icon {{ "extras/extera_badge", profileVerifiedCheckBg }};

winEnterWithGuestIcon: icon {{ "extras/ghost_tray", windowFg }};

editedIcon: IconEmoji{
    icon: icon{{ "extras/edited", windowFg }};
    padding: margins(0px, 0px, 0px, 0px);
    useIconColor: false;
}

deletedIcon: IconEmoji{
    icon: icon{{ "extras/trash_bin", windowFg }};
    padding: margins(0px, 0px, 0px, 0px);
    useIconColor: false;
}

burntIcon: IconEmoji{
    icon: icon{{ "extras/burnt", windowFg }};
    padding: margins(0px, 0px, 0px, 0px);
    useIconColor: false;
}

dialogsExteraOfficialIcon: ThreeStateIcon {
	icon: icon {{ "extras/dialogs_extera_official", dialogsVerifiedIconBg }};
	over: icon {{ "extras/dialogs_extera_official", dialogsVerifiedIconBgOver }};
	active: icon {{ "extras/dialogs_extera_official", dialogsVerifiedIconBgActive }};
}

extrasHistoryFileInPlugin: icon {{ "extras/history_file_plugin", historyFileInIconFg }};
extrasHistoryFileInPluginSelected: icon {{ "extras/history_file_plugin", historyFileInIconFgSelected }};
extrasHistoryFileOutPlugin: icon {{ "extras/history_file_plugin", historyFileOutIconFg }};
extrasHistoryFileOutPluginSelected: icon {{ "extras/history_file_plugin", historyFileOutIconFgSelected }};

menuIconClearAttention: icon {{ "menu/clear", menuIconAttentionColor }};

dialogsExteraSupporterIcon: ThreeStateIcon {
	icon: icon {{ "extras/dialogs_extera_supporter", dialogsVerifiedIconBg }};
	over: icon {{ "extras/dialogs_extera_supporter", dialogsVerifiedIconBgOver }};
	active: icon {{ "extras/dialogs_extera_supporter", dialogsVerifiedIconBgActive }};
}
