using "boxes/boxes.style";
using "settings/settings.style";

// 填充式输入框：与聊天列表搜索框同底色，聚焦时换成淡强调色。
proxyFormBg: filterInputInactiveBg;
proxyFormBgActive: lightButtonBgOver;
proxyFormInput: InputField(defaultInputField) {
	textBg: proxyFormBg;
	textBgActive: proxyFormBgActive;
	// 上边距决定文字位置：12px 时文字与占位文字在 42px 高度内上下居中。
	textMargins: margins(12px, 12px, 12px, 10px);
	placeholderFont: font(14px);
	placeholderScale: 0.;
	placeholderShift: 0px;
	borderRadius: 10px;
	// 描边与底色同色，平时看不出；输入有误时变成红色描边。
	borderFg: proxyFormBg;
	borderFgActive: proxyFormBgActive;
	border: 1px;
	borderActive: 1px;
	heightMin: 42px;
	heightMax: 42px;
}
connectionHostInputField: InputField(proxyFormInput) {
	width: 160px;
}
connectionPortInputField: InputField(proxyFormInput) {
	width: 84px;
}
connectionUserInputField: InputField(proxyFormInput) {
}
connectionPasswordInputField: InputField(proxyFormInput) {
}
// 「使用代理」总开关：半粗标题，标题下方留出一行状态文字。
proxyUseButton: SettingsButton(settingsButtonNoIcon) {
	style: TextStyle(boxTextStyle) {
		font: font(boxFontSize semibold);
	}
	padding: margins(20px, 12px, 20px, 34px);
	toggleSkip: 20px;
	textBg: transparent;
}
proxyUseStatus: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
	maxHeight: 20px;
}
proxyUseStatusSkip: 3px;
// 列表里的操作行：图标与单选圈同列，文字与代理地址对齐。
proxyListAction: SettingsButton(settingsButtonNoIcon) {
	textFg: lightButtonFg;
	textFgOver: lightButtonFgOver;
	style: boxTextStyle;
	padding: margins(54px, 10px, 20px, 10px);
	iconLeft: 19px;
	textBg: transparent;
}
proxyListAddIcon: icon {{ "menu/add", lightButtonFg }};
proxyListPasteIcon: icon {{ "menu/import_theme", lightButtonFg }};

// 代理类型选择字段：与输入框同底色、同圆角，左侧类型图标，右侧下拉箭头。
proxyTypeFieldPadding: margins(10px, 8px, 12px, 8px);
proxyTypeFieldTextLeft: 46px;
proxyTypeFieldNameFont: font(14px semibold);
proxyTypeFieldAboutFont: font(12px);
proxyTypeFieldArrow: icon {{ "info/edit/expand_arrow_small", windowSubTextFg }};
proxyTypeFieldArrowOpened: icon {{ "info/edit/expand_arrow_small-flip_vertical", windowSubTextFg }};
proxyTypeFieldBgOver: windowBgRipple;
proxyTypeFieldRipple: RippleAnimation(defaultRippleAnimation) {
	color: lightButtonBgRipple;
}
// 类型菜单与字段同宽，与字段之间的竖向间距。
proxyTypeMenuSkip: 4px;
proxyTypeMenuItemSkip: 7px;
// 赞助频道提示：与输入框同底色的圆角卡片，左侧信息图标。
proxyEditWarningMargin: margins(20px, 12px, 20px, 0px);
proxyEditWarningPadding: margins(42px, 10px, 12px, 10px);
proxyEditWarningIcon: icon {{ "menu/info", windowSubTextFg }};
// 24px 图标中心与首行文字中心（上边距 10px 加半个行高）同高。
proxyEditWarningIconPosition: point(10px, 7px);
proxyEditWarningLabel: FlatLabel(boxDividerLabel) {
	minWidth: 100px;
}
// 从剪贴板自动填写：图标与输入框左边缘对齐。
proxyEditPasteButton: SettingsButton(proxyListAction) {
	padding: margins(52px, 10px, 20px, 10px);
	iconLeft: 18px;
}
proxyRowPadding: margins(20px, 10px, 8px, 10px);
// 单选圈占位：圈的直径加与文字的间距。
proxyRowCheckSkip: 34px;
proxyRowSkip: 2px;
// 状态行前的圆点，与检测动画同位，颜色随状态取 proxyRowStatusFg* 系列。
proxyRowStatusDotSize: 6px;
proxyRowTitleFg: windowFg;
proxyRowTitlePalette: TextPalette(defaultTextPalette) {
	linkFg: windowSubTextFg;
}
proxyRowTitleStyle: TextStyle(defaultTextStyle) {
	font: semiboldFont;
}
proxyRowStatusFg: windowSubTextFg;
proxyRowStatusFgOnline: windowActiveTextFg;
proxyRowStatusFgOffline: boxTextFgError;
proxyRowStatusFgAvailable: boxTextFgGood;
proxyEditTitle: FlatLabel(defaultFlatLabel) {
	style: TextStyle(defaultTextStyle) {
		font: font(12px semibold);
	}
	textFg: windowSubTextFg;
}
proxyEditTitlePadding: margins(20px, 12px, 20px, 6px);
proxyEditWidth: 480px;
proxyEditTypePadding: margins(22px, 4px, 22px, 8px);
proxyEditInputPadding: margins(20px, 0px, 20px, 0px);
proxyEditSkip: 12px;
proxyCheckingPosition: point(2px, 5px);
proxyCheckingSkip: 6px;
proxyCheckingAnimation: InfiniteRadialAnimation(defaultInfiniteRadialAnimation) {
	color: windowSubTextFg;
	thickness: 1px;
	size: size(8px, 8px);
}
proxyApplyBoxTable: Table(defaultTable) {
	labelMinWidth: 91px;
}
proxyApplyBoxTableMargin: margins(24px, 4px, 24px, 4px);
proxyApplyBoxTableLabelMargin: margins(13px, 10px, 13px, 10px);
proxyApplyBoxTableValueMargin: margins(13px, 9px, 13px, 9px);
proxyApplyBoxValueMultiline: FlatLabel(defaultTableValue) {
	minWidth: 128px;
	maxHeight: 100px;
	style: TextStyle(defaultTextStyle) {
		font: font(10px);
		linkUnderline: kLinkUnderlineNever;
	}
}
proxyApplyBoxSponsorLabel: FlatLabel(defaultFlatLabel) {
	textFg: windowBoldFg;
	minWidth: 100px;
	align: align(top);
	style: TextStyle(defaultTextStyle) {
		font: font(11px);
	}
}
proxyApplyBoxSponsorMargin: margins(13px, 8px, 13px, 8px);
proxyApplyBox: Box(defaultBox) {
	buttonPadding: margins(22px, 11px, 22px, 22px);
	buttonHeight: 38px;
	buttonWide: true;
	button: proxyApplyBoxButton;
}
